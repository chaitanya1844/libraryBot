<?xml version="1.0"?>
<model>
  <name>libbot_rfid_book</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <author>
    <name>libraryBot</name>
    <email>chaitanyabht@gmail.com</email>
  </author>
  <description>
    A simple RFID-tagged book prop used at the intake station. Real RFID
    hardware is not simulated at the physics level; libbot_perception's
    rfid_reader_node correlates this model's pose (via /libbot/model_states)
    against libbot_sorting/config/book_catalog.yaml to fire simulated
    RfidTag reads when the robot is within read range.
  </description>
</model>
