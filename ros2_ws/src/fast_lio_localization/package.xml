<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>fast_lio_localization</name>
  <version>0.0.0</version>
  <description>
    ROS2 port of HViktorTsoi/FAST_LIO_LOCALIZATION (ICP relocalization of
    a live FAST-LIO2 session against a saved PCD map) -- trimmed to just
    global_localization.py + publish_initial_pose.py, see CMakeLists.txt.
  </description>
  <maintainer email="dev@livoxtech.com">claydergc</maintainer>
  <license>BSD</license>
  <author email="zhangji@cmu.edu">Ji Zhang</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <!-- No rosdep keys: pip install open3d tf_transformations ros2_numpy -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
