<?xml version="1.0"?>
<robot name="libbot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="use_gazebo" default="true"/>

  <xacro:include filename="$(find libbot_description)/urdf/base/base.urdf.xacro"/>
  <xacro:include filename="$(find libbot_description)/urdf/base/payload_platform.urdf.xacro"/>
  <xacro:include filename="$(find libbot_description)/urdf/arm/arm.urdf.xacro"/>
  <xacro:include filename="$(find libbot_description)/urdf/sensors/imu.urdf.xacro"/>
  <xacro:include filename="$(find libbot_description)/urdf/sensors/lidar_3d.urdf.xacro"/>
  <xacro:include filename="$(find libbot_description)/urdf/sensors/depth_camera_gazebo.urdf.xacro"/>
  <xacro:include filename="$(find realsense2_description)/urdf/_d435i.urdf.xacro"/>

  <xacro:libbot_imu parent="base_link" xyz="0 0 ${chassis_z/2 + 0.01}"/>

  <!-- Riser between the mast puck top and the lidar: purely cosmetic
       (thin standoff cylinder, no functional role), added because the
       lidar's mount height is deliberately well above the puck (next
       block down), which otherwise reads as the lidar floating
       disconnected above the robot rather than mounted on it. -->
  <link name="lidar_riser_link">
    <visual>
      <geometry><cylinder radius="0.05" length="0.12"/></geometry>
      <material name="libbot_wheel_black"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>
  <joint name="lidar_riser_joint" type="fixed">
    <parent link="sensor_mast_link"/>
    <child link="lidar_riser_link"/>
    <!-- Spans mast top (z=mast_height/2=0.06) up to the lidar's bottom
         face (lidar origin 0.21 minus its own half-height 0.03 = 0.18),
         so length=0.12 centered at z=0.12 (=mast_height/2+0.06) touches
         both with no gap, under the lidar's own forward-shifted x value. -->
    <origin xyz="0.04 0 ${mast_height/2 + 0.06}" rpy="0 0 0"/>
  </joint>

  <!-- Raised well above the sensor-mast puck top (was only 0.03m above
       it, so the lidar's own downward FOV rays clipped the mast/chassis
       fascia at short range, especially once the robot started moving);
       kept unchanged, only x shifted slightly forward per request, with
       the riser above now visually connecting it to the puck instead of
       leaving a bare gap. -->
  <!-- horizontal_samples/channels trimmed from the macro's defaults
       (600/40 -> 400/28, ~47% fewer points/scan): measured this sim
       running well below its own configured 5Hz on this machine
       (gzserver alone pinned over 1 CPU core, actual scan rate ~3.3Hz).
       Gazebo's CPU ray sensor cost scales with point count, and nav2's
       costmap/FAST-LIO2's own voxel-downsampled registration don't need
       anywhere near the full density this was generating. Still full
       360deg coverage at a vertical resolution well above what's needed
       to catch shelf-height obstacles. -->
  <xacro:libbot_lidar_3d parent="sensor_mast_link" xyz="0.04 0 ${mast_height/2 + 0.15}" hz="5"
                          horizontal_samples="400" channels="28"/>

  <!-- RealSense D435i mounted forward-facing on the chassis's upper
       front face at roughly mid-shelf height, angled down slightly to
       see the shelf slots directly in front of the robot. (Used to be
       mounted on the mast when the mast was tall; now the chassis
       itself carries most of the robot's height, see base.urdf.xacro.) -->
  <xacro:sensor_d435i parent="base_link" name="camera" use_nominal_extrinsics="true">
    <origin xyz="${chassis_x/2 + 0.015} 0 ${chassis_z*0.30}" rpy="0 0.20 0"/>
  </xacro:sensor_d435i>
  <!-- Trimmed from the macro's 640x480@15hz default (307,200 points/frame,
       4.6M pts/sec): the local costmap only needs enough resolution to
       catch obstacles at 5cm-ish granularity within a few meters, and
       colorization (lidar_camera_colorizer.py) reads the separate
       image_raw/camera_info topics, not this point count, so it's
       unaffected by shrinking it. Was a large, measurable share of both
       Gazebo's own per-frame render/sensor cost and every downstream
       consumer's (costmap, RViz) point-processing cost for resolution
       nothing here actually uses. -->
  <xacro:libbot_depth_camera_gazebo camera_name="camera" width="320" height="240" hz="10"/>

  <xacro:if value="$(arg use_gazebo)">
    <xacro:include filename="$(find libbot_description)/urdf/control/ros2_control.urdf.xacro"/>
    <xacro:include filename="$(find libbot_description)/urdf/gazebo/planar_move.urdf.xacro"/>
  </xacro:if>

</robot>
