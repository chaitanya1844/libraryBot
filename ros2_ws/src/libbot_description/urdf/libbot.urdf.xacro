<?xml version="1.0"?>
<robot name="libbot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="use_gazebo" default="true"/>

  <xacro:include filename="$(find libbot_description)/urdf/base/base.urdf.xacro"/>
  <xacro:include filename="$(find libbot_description)/urdf/base/payload_platform.urdf.xacro"/>
  <xacro:include filename="$(find libbot_description)/urdf/arm/arm.urdf.xacro"/>
  <xacro:include filename="$(find libbot_description)/urdf/sensors/imu.urdf.xacro"/>
  <xacro:include filename="$(find libbot_description)/urdf/sensors/lidar_3d.urdf.xacro"/>
  <xacro:include filename="$(find libbot_description)/urdf/sensors/depth_camera_gazebo.urdf.xacro"/>
  <xacro:include filename="$(find realsense2_description)/urdf/_d435i.urdf.xacro"/>

  <xacro:libbot_imu parent="base_link" xyz="0 0 ${chassis_z/2 + 0.01}"/>

  <xacro:libbot_lidar_3d parent="sensor_mast_link" xyz="0 0 ${mast_height/2 + 0.03}" hz="5"/>

  <!-- RealSense D435i mounted forward-facing on the chassis's upper
       front face at roughly mid-shelf height, angled down slightly to
       see the shelf slots directly in front of the robot. (Used to be
       mounted on the mast when the mast was tall; now the chassis
       itself carries most of the robot's height, see base.urdf.xacro.) -->
  <xacro:sensor_d435i parent="base_link" name="camera" use_nominal_extrinsics="true">
    <origin xyz="${chassis_x/2 + 0.015} 0 ${chassis_z*0.30}" rpy="0 0.20 0"/>
  </xacro:sensor_d435i>
  <xacro:libbot_depth_camera_gazebo camera_name="camera"/>

  <xacro:if value="$(arg use_gazebo)">
    <xacro:include filename="$(find libbot_description)/urdf/control/ros2_control.urdf.xacro"/>
    <xacro:include filename="$(find libbot_description)/urdf/gazebo/planar_move.urdf.xacro"/>
  </xacro:if>

</robot>
