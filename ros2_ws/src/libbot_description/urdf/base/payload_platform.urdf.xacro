<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Short, wide sensor puck riser sitting directly on top of the
       (now tall/thick) chassis, replacing the old 0.85m thin mast,
       which read as "a pole stuck through the middle of a skateboard"
       rather than a real service-robot body. Reference: Peppermint
       SD20-style AMRs are one tall shell with the lidar mounted almost
       flush on top, no visible shaft. The link is still named
       sensor_mast_link (lidar_3d/depth camera mounts in libbot.urdf.xacro
       reference it by name), it's just short and chunky now instead of
       tall and thin. Total robot height still lands close to the
       original ~3.5ft (1.07m) target; see README "Chassis dimensions". -->

  <xacro:property name="mast_height" value="0.12"/>
  <xacro:property name="mast_radius" value="0.14"/>

  <link name="sensor_mast_link">
    <visual>
      <geometry><cylinder radius="${mast_radius}" length="${mast_height}"/></geometry>
      <material name="libbot_body_grey"/>
    </visual>
    <collision>
      <geometry><cylinder radius="${mast_radius}" length="${mast_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="sensor_mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_mast_link"/>
    <origin xyz="0 0 ${chassis_z/2 + mast_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- Book collection basket on the front, at an accessible low-middle
       height on the body. Same 0.16 x 0.24 footprint as the flat tray
       this replaces (no change to the robot's overall size/silhouette),
       just floor + 4 thin walls on that same footprint so books
       book_sorter_node.py attaches here visually sit inside a basket
       instead of floating on a bare plate. -->
  <xacro:property name="basket_wall_h" value="0.08"/>
  <xacro:property name="basket_wall_t" value="0.01"/>
  <link name="book_tray_link">
    <visual>
      <geometry><box size="0.16 0.24 0.02"/></geometry>
      <material name="libbot_body_teal"/>
    </visual>
    <collision>
      <geometry><box size="0.16 0.24 0.02"/></geometry>
    </collision>
    <!-- Front/back walls (span y, thin in x) -->
    <visual>
      <origin xyz="0.075 0 ${0.01 + basket_wall_h/2}" rpy="0 0 0"/>
      <geometry><box size="${basket_wall_t} 0.24 ${basket_wall_h}"/></geometry>
      <material name="libbot_body_teal"/>
    </visual>
    <collision>
      <origin xyz="0.075 0 ${0.01 + basket_wall_h/2}" rpy="0 0 0"/>
      <geometry><box size="${basket_wall_t} 0.24 ${basket_wall_h}"/></geometry>
    </collision>
    <visual>
      <origin xyz="-0.075 0 ${0.01 + basket_wall_h/2}" rpy="0 0 0"/>
      <geometry><box size="${basket_wall_t} 0.24 ${basket_wall_h}"/></geometry>
      <material name="libbot_body_teal"/>
    </visual>
    <collision>
      <origin xyz="-0.075 0 ${0.01 + basket_wall_h/2}" rpy="0 0 0"/>
      <geometry><box size="${basket_wall_t} 0.24 ${basket_wall_h}"/></geometry>
    </collision>
    <!-- Left/right walls (span x, thin in y) -->
    <visual>
      <origin xyz="0 0.115 ${0.01 + basket_wall_h/2}" rpy="0 0 0"/>
      <geometry><box size="0.16 ${basket_wall_t} ${basket_wall_h}"/></geometry>
      <material name="libbot_body_teal"/>
    </visual>
    <collision>
      <origin xyz="0 0.115 ${0.01 + basket_wall_h/2}" rpy="0 0 0"/>
      <geometry><box size="0.16 ${basket_wall_t} ${basket_wall_h}"/></geometry>
    </collision>
    <visual>
      <origin xyz="0 -0.115 ${0.01 + basket_wall_h/2}" rpy="0 0 0"/>
      <geometry><box size="0.16 ${basket_wall_t} ${basket_wall_h}"/></geometry>
      <material name="libbot_body_teal"/>
    </visual>
    <collision>
      <origin xyz="0 -0.115 ${0.01 + basket_wall_h/2}" rpy="0 0 0"/>
      <geometry><box size="0.16 ${basket_wall_t} ${basket_wall_h}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0006" ixy="0" ixz="0" iyy="0.0006" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="book_tray_joint" type="fixed">
    <parent link="base_link"/>
    <child link="book_tray_link"/>
    <!-- x was 0.14, well inside the chassis's own front face at
         chassis_x/2=0.25 (chassis_x=0.50): the basket was entirely
         embedded in the solid chassis box, invisible from outside
         (same teal material as the chassis besides). Mounted just
         proud of the front face instead so it actually protrudes and
         is visible: chassis_x/2 + half the basket's own depth
         (0.16/2=0.08), i.e. flush against the face. -->
    <origin xyz="${chassis_x/2 + 0.08} 0 ${-chassis_z/2 + 0.25}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="sensor_mast_link">
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="book_tray_link">
    <material>Gazebo/Turquoise</material>
  </gazebo>

</robot>
