<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Short, wide sensor puck riser sitting directly on top of the
       (now tall/thick) chassis, replacing the old 0.85m thin mast,
       which read as "a pole stuck through the middle of a skateboard"
       rather than a real service-robot body. Reference: Peppermint
       SD20-style AMRs are one tall shell with the lidar mounted almost
       flush on top, no visible shaft. The link is still named
       sensor_mast_link (lidar_3d/depth camera mounts in libbot.urdf.xacro
       reference it by name), it's just short and chunky now instead of
       tall and thin. Total robot height still lands close to the
       original ~3.5ft (1.07m) target; see README "Chassis dimensions". -->

  <xacro:property name="mast_height" value="0.12"/>
  <xacro:property name="mast_radius" value="0.14"/>

  <link name="sensor_mast_link">
    <visual>
      <geometry><cylinder radius="${mast_radius}" length="${mast_height}"/></geometry>
      <material name="libbot_body_grey"/>
    </visual>
    <collision>
      <geometry><cylinder radius="${mast_radius}" length="${mast_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="sensor_mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_mast_link"/>
    <origin xyz="0 0 ${chassis_z/2 + mast_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- Book intake tray on the front, at an accessible low-middle height
       on the body rather than tracking the (now much taller) body top. -->
  <link name="book_tray_link">
    <visual>
      <geometry><box size="0.16 0.24 0.02"/></geometry>
      <material name="libbot_body_teal"/>
    </visual>
    <collision>
      <geometry><box size="0.16 0.24 0.02"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0006" ixy="0" ixz="0" iyy="0.0006" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="book_tray_joint" type="fixed">
    <parent link="base_link"/>
    <child link="book_tray_link"/>
    <origin xyz="0.14 0 ${-chassis_z/2 + 0.25}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="sensor_mast_link">
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="book_tray_link">
    <material>Gazebo/Turquoise</material>
  </gazebo>

</robot>
