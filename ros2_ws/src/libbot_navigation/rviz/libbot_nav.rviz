Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: libbot_rviz_plugins/LibbotControlPanel
    Name: libraryBot Controls
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Color: 80; 80; 80
      Alpha: 0.4

    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Description Topic:
        Value: /libbot/robot_description
        Depth: 1
        Durability Policy: Transient Local
      Enabled: true
      Visual Enabled: true

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: false
      Marker Scale: 0.4

    - Class: rviz_default_plugins/Map
      Name: Map
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
      Alpha: 0.7
      Enabled: true

    # Live 2D preview while mapping (mapping_preview_node.py) -- FAST-LIO2
    # itself has no equivalent of slam_toolbox's live 2D map, only the 3D
    # /Laser_map cloud above; this re-projects that same cloud into an
    # OccupancyGrid every couple seconds so there's visual feedback that
    # mapping is progressing. Volatile (default rclpy QoS), not
    # Transient Local like the real map above -- that one comes from
    # map_server, this one doesn't.
    - Class: rviz_default_plugins/Map
      Name: MappingPreview
      Topic:
        Value: /mapping_preview_map
        Depth: 1
        Durability Policy: Volatile
      Alpha: 0.7
      Enabled: true

    # Global/local Nav2 costmaps -- the rainbow magenta/cyan cost gradient.
    - Class: rviz_default_plugins/Map
      Name: GlobalCostmap
      Topic:
        Value: /global_costmap/costmap
        Depth: 1
        Durability Policy: Transient Local
      Color Scheme: costmap
      Alpha: 0.5
      Draw Behind: false
      Enabled: true

    - Class: rviz_default_plugins/Map
      Name: LocalCostmap
      Topic:
        Value: /local_costmap/costmap
        Depth: 1
        Durability Policy: Volatile
      Color Scheme: costmap
      Alpha: 0.6
      Draw Behind: false
      Enabled: true

    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
      Size (m): 0.04
      Style: Flat Squares
      Color: 255; 60; 60
      Enabled: false

    # Main 3D perception sensor: full 3D lidar point cloud, rainbow-colored
    # by height (matches the reference visualization style).
    # De-emphasized on purpose: this is the raw current-instant sensor
    # scan, not the accumulated map (that's FastLioCloud/Laser_map below)
    # -- kept small/dim so it doesn't visually compete with the map
    # that's actually building up.
    - Class: rviz_default_plugins/PointCloud2
      Name: Lidar3D
      Topic:
        Value: /libbot/lidar_3d/points_filtered
        Depth: 5
        Durability Policy: Volatile
      Size (m): 0.02
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 120; 40; 40
      Alpha: 0.5
      Autocompute Value Bounds: true
      Use Fixed Frame: true
      Enabled: true

    # On by default per user request. The D435i's raw depth cloud is
    # ~307k points/frame (640x480), heavy enough to strain VRAM on
    # constrained GPUs when rendered alongside Gazebo + the lidar cloud +
    # costmaps -- if rviz2 crashes/stutters, disable this first (the 2D
    # CameraColor image below gives the same "see what the camera sees"
    # view far more cheaply) or lower width/height/hz in
    # depth_camera_gazebo.urdf.xacro.
    - Class: rviz_default_plugins/PointCloud2
      Name: DepthCameraPointCloud
      Topic:
        Value: /libbot/camera/camera/points
        Depth: 5
        Durability Policy: Volatile
      Size (m): 0.015
      Style: Flat Squares
      Color Transformer: RGB8
      Enabled: true

    # Off by default: rviz2's Image display allocates its own separate
    # GL render target, which reliably crashed rviz2 on this box's GPU
    # driver ("libGL error: failed to create drawable" -> Ogre
    # "Vertex Buffer: Out of memory" -> SIGABRT), independent of the
    # topic's actual bandwidth. Enable it if your GPU/driver handles
    # multiple simultaneous GL contexts; otherwise view the camera with
    # `ros2 run rqt_image_view rqt_image_view` instead, which renders in
    # its own process and doesn't share rviz2's GL context.
    - Class: rviz_default_plugins/Image
      Name: CameraColor
      Topic:
        Value: /libbot/camera/camera/image_raw
        Depth: 5
        Durability Policy: Volatile
      Enabled: false

    # FAST-LIO2's own registered 3D map + tracked trajectory -- this is
    # Nav2's actual localization source now (see "2. Start Localization"
    # in the control panel / localization_fastlio.launch.py), replacing
    # AMCL, so on by default.
    # /Laser_map, NOT /cloud_registered: the latter is only FAST-LIO2's
    # current-instant scan (republished every frame, never accumulates)
    # -- this is the actual growing map (pcl_wait_pub, only populated
    # because fast_lio_libbot.yaml sets publish.map_en: true), highlighted
    # (bright yellow, larger points) so it's obvious mapping is working.
    - Class: rviz_default_plugins/PointCloud2
      Name: FastLioCloud
      Topic:
        Value: /Laser_map
        Depth: 5
        Durability Policy: Volatile
      Size (m): 0.03
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 255; 255; 0
      Alpha: 1.0
      Enabled: true

    - Class: rviz_default_plugins/Path
      Name: FastLioPath
      Topic:
        Value: /path
        Durability Policy: Volatile
      Color: 255; 0; 0
      Line Width: 0.03
      Enabled: true

    - Class: rviz_default_plugins/Path
      Name: GlobalPlan
      Topic:
        Value: /plan
        Durability Policy: Volatile
      Color: 12; 227; 14
      Line Width: 0.04
      Enabled: true

    - Class: rviz_default_plugins/Path
      Name: LocalPlan
      Topic:
        Value: /local_plan
        Durability Policy: Volatile
      Color: 255; 200; 0
      Line Width: 0.03
      Enabled: true

    # Breadcrumb trail of where the robot has actually driven in the last
    # ~20s (published by libbot_perception's trail_publisher_node as a
    # MarkerArray so each point can fade by age), distinct from
    # GlobalPlan/LocalPlan above which show where it's *going* right now.
    - Class: rviz_default_plugins/MarkerArray
      Name: Trail
      Topic:
        Value: /libbot/trail
        Durability Policy: Volatile
      Enabled: true

    # Nav2's actual planning footprint polygons -- shows the exact
    # collision boundary the planner/controller reason about, not just
    # the visual robot model. Useful for demonstrating *why* Nav2 picked
    # a given path (e.g. why it won't cut a corner close to a shelf).
    - Class: rviz_default_plugins/Polygon
      Name: LocalFootprint
      Topic:
        Value: /local_costmap/published_footprint
        Durability Policy: Volatile
      Color: 255; 255; 0
      Enabled: true

    - Class: rviz_default_plugins/Polygon
      Name: GlobalFootprint
      Topic:
        Value: /global_costmap/published_footprint
        Durability Policy: Volatile
      Color: 0; 255; 255
      Enabled: false

  Global Options:
    Background Color: 20; 20; 24
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: nav2_rviz_plugins/GoalTool
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 9
      Focal Point:
        X: 1
        Y: 3.3
        Z: 0.4
      Pitch: 0.9
      Yaw: 1.0
      Near Clip Distance: 0.01
Window Geometry:
  X: 0
  Y: 74
  Height: 1312
  Width: 2560
  Displays:
    collapsed: false
  libraryBot Controls:
    collapsed: false
  Views:
    collapsed: true
  CameraColor:
    collapsed: false
