<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>libbot_bringup</name>
  <version>0.1.0</version>
  <description>Top-level launch orchestration for the libraryBot simulation stack</description>
  <maintainer email="chaitanyabht@gmail.com">chaitanyabht</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>libbot_description</exec_depend>
  <exec_depend>libbot_gazebo</exec_depend>
  <exec_depend>libbot_control</exec_depend>
  <exec_depend>libbot_fastlio</exec_depend>
  <exec_depend>libbot_navigation</exec_depend>
  <exec_depend>libbot_perception</exec_depend>
  <exec_depend>libbot_manipulation</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
