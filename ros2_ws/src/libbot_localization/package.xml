<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>libbot_localization</name>
  <version>0.1.0</version>
  <description>EKF (robot_localization) and AMCL localization configuration for libraryBot</description>
  <maintainer email="chaitanyabht@gmail.com">chaitanyabht</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_localization</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>libbot_mapping</exec_depend>
  <!-- 3D localization (localization_3d.launch.py) against the 3D lidar +
       IMU via FAST-LIO2, not resolvable via rosdep: built from source as
       a separate overlay workspace, see that launch file's docstring. -->
  <exec_depend>fast_lio</exec_depend>
  <exec_depend>libbot_perception</exec_depend>

  <!-- fastlio_map_odom_bridge.py (localization_fastlio.launch.py) -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <!-- Open3D (ICP against a saved PCD map, fastlio_map_odom_bridge.py's
       pcd_map_path option) has no rosdep key, install via
       "pip install open3d". Already present on this dev machine. Also
       used by libbot_mapping/scripts/pcd_to_2d_map.py. -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
