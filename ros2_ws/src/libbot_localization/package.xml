<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>libbot_localization</name>
  <version>0.1.0</version>
  <description>EKF (robot_localization) and FAST-LIO2 (3D lidar-inertial) localization configuration for libraryBot</description>
  <maintainer email="chaitanyabht@gmail.com">chaitanyabht</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_localization</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>libbot_mapping</exec_depend>
  <!-- 3D localization (localization_3d.launch.py) against the 3D lidar +
       IMU via FAST-LIO2, not resolvable via rosdep: built from source as
       a separate overlay workspace, see that launch file's docstring. -->
  <exec_depend>fast_lio</exec_depend>
  <exec_depend>libbot_perception</exec_depend>
  <!-- localization_fastlio.launch.py's actual relocalization-against-a-
       saved-map engine (fastlio_map_odom_bridge.py just relays its
       /map_to_odom output, see that package's own docstring). -->
  <exec_depend>fast_lio_localization</exec_depend>

  <!-- fastlio_map_odom_bridge.py (localization_fastlio.launch.py) -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
