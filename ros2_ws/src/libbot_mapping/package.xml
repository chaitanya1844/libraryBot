<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>libbot_mapping</name>
  <version>0.1.0</version>
  <description>SLAM Toolbox mapping configuration and saved maps for libraryBot</description>
  <maintainer email="chaitanyabht@gmail.com">chaitanyabht</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>nav2_map_server</exec_depend>
  <!-- mapping.launch.py includes libbot_localization's FAST-LIO2 3D
       mapping launch at runtime (slam_toolbox was the pre-FAST-LIO2
       mapping source; removed, both would fight over map -> odom). Not
       declared as an exec_depend: libbot_localization already depends
       on libbot_mapping (for the maps/ dir + pcd_to_2d_map.py output),
       and colcon refuses to order a circular package dependency. -->
  <!-- scripts/pcd_to_2d_map.py: Open3D has no rosdep key, `pip install
       open3d`; PyYAML is python3-yaml. -->
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
