# colcon build outputs -- regenerated by `colcon build`, not source.
# Covers both the correct location (ros2_ws/) and the top level, in case
# `colcon build` is ever accidentally run from the repo root instead of
# ros2_ws/.
build/
install/
log/

# Python
__pycache__/
*.pyc

# Editor/OS cruft
.vscode/
*.swp
.DS_Store

# FAST-LIO2 PCD maps (large binary, machine/run-specific -- generate with
# `ros2 service call /map_save std_srvs/srv/Trigger`, see
# libbot_mapping/launch/mapping.launch.py)
ros2_ws/src/libbot_mapping/pcd_maps/*.pcd
