# colcon build outputs -- regenerated by `colcon build`, not source.
# Covers both the correct location (ros2_ws/) and the top level, in case
# `colcon build` is ever accidentally run from the repo root instead of
# ros2_ws/.
build/
install/
log/

# Python
__pycache__/
*.pyc

# Editor/OS cruft
.vscode/
*.swp
.DS_Store
